#!/bin/sh

if [ -n "$WAYLAND_DISPLAY" ]; then
    is_wayland=1
    screenshotter="grim"
    clipboard_saver="wl-copy"
else
    is_wayland=0
    screenshotter="maim --hidecursor"
    clipboard_saver="xclip -selection clipboard -t image/png"
fi

save=0
area=0
for arg in "$@"; do
    if [ "$arg" = "area" ]; then
        area=1
    elif [ "$arg" = "save" ]; then
        save=1
    else
        echo make a screenshot using maim + slop / grim + slurp
        echo specify \"area\" to crop, \"save\" to save to $HOME/Pictures
        echo image is saved at /tmp if \"save\" is not specified. in both cases the save path is printed
        echo usage: screenshot arg1 arg2 ...
        echo args:
        echo - save: save to $HOME/Pictures/
        echo - area: screen snipping
        echo order isnt matter
        echo examples:
        echo - screenshot
        echo - screenshot area
        echo - screenshot save
        echo - screenshot save area
        exit 1
    fi
done

tmpf=$(mktemp /tmp/scrsht-XXXXX.png)

if [ $is_wayland -eq 1 ]; then
    if [ $area -eq 1 ]; then
        geometry=$(slurp)
        if [ $? -ne 0 ]; then
            return 1
        fi
        grim -g "$geometry" $tmpf
    else
        grim $tmpf
    fi
else
    if [ $area -eq 1 ]; then
        maim --hidecursor -s $tmpf
    else
        maim --hidecursor $tmpf
    fi
fi

success=$?
if [ $success -ne 0 ]; then
    rm $tmpf
    exit 1
fi

cat $tmpf | $clipboard_saver

prefix=''
if [ $save -eq 1 ]; then
    savedir="$HOME/Pictures"
    savename="$savedir/$(date +"%Y-%m-%d_%H-%M-%S").png"
    prefix=" and saved to $savedir"
    cp $tmpf $savename
fi

notify-send "Screen captured" "Image copied to clipboard$prefix" -i $tmpf

if [ $save -eq 1 ]; then
    rm $tmpf
    echo $savename
else
    echo $tmpf
fi
